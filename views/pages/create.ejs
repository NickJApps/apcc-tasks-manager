<div class="wrapper">
    <h1 class="page-title">создать задачу</h1>
    <form id="create-target">


        <!-- Общая информация о селлере -->
        <section class="details-secction">
            <!-- Заголовок -->
            <h2 class="section-title">ОБЩИЕ</h2>

            <div class="details-grid">
                <!-- Дата создания -->
                <div class="field-label create-field-label">
                    <span>Дата создания</span>
                </div>
                <div class="field-value">
                    <input id="creation-date" type="date" name="creation_date">
                </div>

                <!-- Seller -->
                <span class="field-label seller-label">Имя / Наименование</span>
                <div class="field-value seller-value">
                    <input id="seller_name" type="text" name="seller_name" placeholder="Введите имя">
                </div>

                <!-- ITN -->

                <div class="field-label">
                    <span>ИНН</span>
                </div>

                <div class="field-value">
                    <input id="itn" type="text" name="itn" placeholder="12-значный код">
                </div>

                <!-- PSRN -->
                <div class="field-label">
                    <span>ОГРН / ОГРНИП</span>
                </div>

                <div class="field-value">
                    <input id="psrn" type="text" name="psrn" placeholder="12- или 15-значный код">
                </div>

                <!-- Region -->
                <div class="field-label">
                    <span>Регион</span>
                </div>

                <div class="field-value wide-value">
                    <input id="region" type="text" name="region" placeholder="Введите регион" >
                </div>

                <!-- Address -->
                <div class="field-label">
                    <span>Адрес</span>
                </div>

                <div class="field-value wide-value">
                    <input id="address" type="text" name="address" placeholder="Введите адрес">
                </div>


                <!-- Comment -->
                <span class="field-label comment-label">Комментарий</span>

                <div class="field-value comment-value">
                    <textarea type="text" name="comment"></textarea>
                </div>

            </div>
        </section>

        <!-- Загрузить данные по селлеру-->

        <section class="details-secction">
            <div class="create-btn-container">
                <button class="get-seller-info-btn" id="check-btn" type="button">Получить данные селлерa по ОГРН</button>
            </div>
        </section>

        <!-- Информация по магазину -->

        <section class="details-secction">

            <h2 class="section-title">ДЕТАЛИ ПО МАГАЗИНУ</h2>

            <div class="store-details">
                <div class="store-grid">

                    <!-- PLATFORM -->
                    <div class="field-label">
                        <span>Платформа</span>
                    </div>

                    <div class="field-value platform-value">
                        <select name="platform" id="platform">
                            <option value="0"></option>
                            <option class="visibility" value="Wildberries">Wildberries</option>
                            <option class="visibility" value="Ozon">Ozon</option>
                            <option class="visibility" value="Yandex">Yandex</option>
                        </select>
                    </div>


                    <!-- STORE LINK -->
                    <div class="field-label">
                        <span>Ссылка на магазин</span>
                    </div>

                    <div class="field-value store-link-value">
                        <input type="text" name="link_store" placeholder="Введите ссылку на магазин" id="link-store">
                        <button type="button" class="link-btn" id="open-store-btn" title="Перейти в магазин">↗</button>
                        <button type="button" class="link-btn" id="clear-store-btn" title="Очистить поле">&#x2715</button>
                    </div>


                    <!-- REVENUE -->
                    <div class="field-label">
                        <span>Выручка</span>
                    </div>

                    <div class="field-value">
                        <input name="monthly_revenue" placeholder="Выручка" type="text" name="revenue" id="revenue">
                    </div>


                    <!-- SALES -->
                    <div class="field-label">
                        <span>Кол-во продаж</span>
                    </div>

                    <div class="field-value">
                        <input type="text" name="sales_number" placeholder="Продажи" id="sales">
                    </div>


                    <!-- STOCK -->
                    <div class="field-label">
                        <span>Остаток</span>
                    </div>

                    <div class="field-value">
                        <input type="text" name="remaining_stock" placeholder="Остаток">
                    </div>

                </div>

            </div>
        </section>

        <!--Информация по закупке-->

        <section class="details-section">
            <div class="test-purchase-container">
                <h2 class="section-title">ДЕТАЛИ ПО ТОВАРУ</h2>

                <div class="test-purchase-item template">
                    <h2 class="purchase-subtitle">Товар № 1</h2>
                    <div class="purchase-grid">

                        <!--PRODUCT TYPE-->
                        <div class="field-label">
                            <span>Продукт</span>
                        </div>

                        <div class="select-wrapper">
                            <select name="product" id="product">
                                <option value="0"></option>
                                <option class="visibility" value="ds4">DualShock</option>
                                <option class="visibility" value="ds5">DualSence</option>
                                <option class="visibility" value="dss">DualShock/Sence</option>
                                <option class="visibility" value="charging">Charging Station</option>
                            </select>
                        </div>

                        <!-- PRICE -->
                        <div class="field-label">
                            <span>Цена</span>
                        </div>

                        <div class="field-value create-field-value">
                            <input type="text" name="product_price" id="product-price">
                        </div>

                        <!-- PRODUCT LINK -->
                        <div class="field-label">
                            <span>Ссылка на товар</span>
                        </div>

                        <div class="field-value product-link-value">

                            <input type="text" name="product_link" id="product-link">
                            <button type="button" class="link-btn open-product-btn" title="Перейти к товару">↗</button>
                            <button type="button" class="link-btn clear-product-btn"
                                title="Очистить поле">&#x2715</button>

                        </div>
                    </div>
                </div>

            </div>

            <div class="product-control">
                <button type="button" id="add-product-btn" class="add-product-btn" title="Добавить товар">&plus;</button>
                <button type="button" id="delete-product-btn" class="delete-product-btn" title="Удалить товар">&minus;
                </button>
            </div>

        </section>

        <!-- Исполнитель -->

        <section class="details-section">
            <div class="store-details">
                <h2 class="section-title">ИСПОЛНИТЕЛЬ</h2>
                <div class="case-grid case-grid-2">

                    <div class="field-label">
                        <span>Исполнитель</span>
                    </div>

                    <div class="field-value product-select">
                        <select name="executant">
                            <option value="APCC">APCC</option>
                            <option value="Мишанский">Мишанский</option>
                        </select>
                    </div>

                </div>
            </div>
        </section>

        <!-- Save Button -->

        <section class="details-section">
            <div class="create-btn-container">
                <button type="submit" class="save-seller-button">Сохранить</button>
            </div>
        </section>

    </form>
</div>

<!--create script include -->
<script src="/js/create.js"></script>