<div class="wrapper">
    <h1 class="page-title">Движение дела</h1>

    <section class="details-section progress-section">

        <h2 class="section-title">Прогресс</h2>

        <div class="progress">

            <div class="progress-step active">
                <div class="step-circle">1</div>
                <span>Создан</span>
            </div>

            <div class="progress-line active"></div>

            <div class="progress-step" id="purchase-step-circle">
                <div class="step-circle">2</div>
                <span>Закупка</span>
            </div>

            <div class="progress-line" id="purchase-step-line"></div>

            <div class="progress-step" id="letter-step-circle">
                <div class="step-circle">3</div>
                <span>Претензия</span>
            </div>

            <div class="progress-line" id="letter-step-line"></div>

            <div class="progress-step" id="lawsuit-step-circle">
                <div class="step-circle">4</div>
                <span>Арбитраж</span>
            </div>

            <div class="progress-line" id="lawsuit-step-line"></div>

            <div class="progress-step">
                <div class="step-circle" id="appeal-step-circle">5</div>
                <span>Апелляция</span>
            </div>

            <div class="progress-line" id="appeal-step-line"></div>

            <div class="progress-step">
                <div class="step-circle" id="execution-step-circle">6</div>
                <span>Исполнительное</span>
            </div>
        </div>

    </section>

    <form id="detales-form" data-itn="<%= itn %>">
        <!-- Общая информация о селлере -->
        <section class="details-section">

            <!-- Заголовок -->
            <h2 class="section-title">ОБЩИЕ</h2>

            <div class="details-grid">
                <!-- Дата создания -->
                <div class="created-date">
                    <span>Дата создания</span>
                    <label id="creation-date">12.12.2026</label>
                </div>

                <!-- Seller -->
                <span class="field-label seller-label">Имя / Наименование</span>
                <div class="field-value seller-value">
                    <label id="seller-name"></label>
                </div>

                <!-- ITN -->
                <div class="field-label">
                    <span>ИНН</span>
                </div>

                <div class="field-value">
                    <label id="itn"></label>
                </div>

                <!-- PSRN -->
                <div class="field-label">
                    <span>ОГРН / ОГРНИП</span>
                </div>

                <div class="field-value">
                    <label id="psrn"></label>
                </div>

                <!-- Region -->
                <div class="field-label">
                    <span>Регион</span>
                </div>

                <div class="field-value wide-value">
                    <input id="region" type="text" name="region">
                </div>

                <!-- Address -->
                <div class="field-label">
                    <span>Адрес</span>
                </div>

                <div class="field-value wide-value">
                    <input id="address" type="text" name="address">
                </div>


                <!-- Comment -->
                <span class="field-label comment-label">Комментарий</span>

                <div class="field-value comment-value">
                    <textarea id="comment" name="comment"></textarea>
                </div>

            </div>
        </section>

        <!-- Информация по магазину -->

        <section class="details-section">
            <div class="store-details">

                <h2 class="section-title">ДЕТАЛИ ПО МАГАЗИНУ</h2>

                <div class="store-grid">

                    <!-- PLATFORM -->
                    <div class="field-label">
                        <span>Платформа</span>
                    </div>

                    <div class="field-value platform-value">
                        <select name="platform" id="platform">
                            <option value="Ozon">Ozon</option>
                            <option value="Wildberries">Wildberries</option>
                            <option value="Yandex">Яндекс Маркет</option>
                        </select>
                    </div>


                    <!-- STORE LINK -->
                    <div class="field-label">
                        <span>Ссылка на магазин</span>
                    </div>

                    <div class="field-value store-link-value">
                        <input type="text" name="link-store" id="link-store">
                        <button type="button" class="link-btn" id="store-link-btn" title="Перейти в магазин">↗</button>
                        <button type="button" class="link-btn" title="Очистить поле">&#x2715</button>
                    </div>


                    <!-- REVENUE -->
                    <div class="field-label">
                        <span>Выручка</span>
                    </div>

                    <div class="field-value">
                        <input type="text" name="monthly-revenue" id="monthly-revenue">
                    </div>


                    <!-- SALES -->
                    <div class="field-label">
                        <span>Кол-во продаж</span>
                    </div>

                    <div class="field-value">
                        <input type="text" name="sales-number" id="sales-number">
                    </div>


                    <!-- STOCK -->
                    <div class="field-label">
                        <span>Остаток</span>
                    </div>

                    <div class="field-value">
                        <input type="text" name="remaining-stock" id="remaining-stock">
                    </div>

                </div>

            </div>
        </section>

        <!--Информация по закупке-->

        <section class="details-section">
            <div class="test-purchase-container">
                <h2 class="section-title">ДЕТАЛИ ПО ТОВАРУ</h2>

                <div class="test-purchase-item template" hidden>

                    <h2 class="purchase-subtitle"></h2>

                    <div class="product-grid">

                        <!-- PRODUCT -->
                        <div class="field-label">
                            <span>Продукт</span>
                        </div>

                        <div class="field-value product-link-value">
                            <select name="product" id="product">
                                <option value="0"></option>
                                <option class="visibility" value="ds4">DualShock</option>
                                <option class="visibility" value="ds5">DualSence</option>
                                <option class="visibility" value="dss">DualShock/Sence</option>
                                <option class="visibility" value="charging">Charging Station</option>
                            </select>
                        </div>


                        <!-- PRODUCT LINK -->
                        <div class="field-label">
                            <span>Ссылка на товар</span>
                        </div>

                        <div class="field-value product-link-value">

                            <input type="text" name="product_link" id="product-link">
                            <button type="button" class="link-btn open-link-btn" title="Перейти к товару">↗</button>
                            <button type="button" class="link-btn clear-field-btn" title="Очистить поле">&#x2715</button>

                        </div>


                        <!-- PRICE -->
                        <div class="field-label">
                            <span>Цена</span>
                        </div>

                        <div class="field-value">
                            <input type="text" name="product_price" id="product-price">
                        </div>


                        <!-- PURCHASE DATE -->
                        <div class="field-label">
                            <span>Дата закупки</span>
                        </div>

                        <div class="field-value">
                            <input id="item-purchase-date" type="date">
                        </div>

                    </div>
                </div>
            </div>
            <div class="product-control">
                <button type="button" id="add-product-btn" class="add-product-btn" title="Добавить товар"> &plus;
                </button>
                <button type="button" id="delete-product-btn" class="delete-product-btn" title="Удалить товар">
                    &minus; </button>
            </div>

        </section>

        <!-- Претензия -->

        <section class="details-section">
            <div class="store-details">
                <h2 class="section-title">ПРЕТЕНЗИЯ</h2>
                <div class="case-grid case-grid-2">

                    <div class="field-label">
                        <span>Отправка претензии (дата)</span>
                    </div>

                    <div class="field-value">
                        <input id="cd-letter-date" type="date">
                    </div>

                </div>
            </div>
        </section>

        <!-- Арбитраж -->

        <section class="details-section">
            <div class="store-details">
                <h2 class="section-title">АРБИТРАЖ</h2>
                <div class="case-grid case-grid-2">
                    <div class="field-label">
                        <span>Иск подан (дата)</span>
                    </div>

                    <div class="field-value">
                        <input id="lawsuit-date" type="date">
                    </div>

                    <div class="field-label">
                        <span>Решение получено (дата)</span>
                    </div>

                    <div class="field-value">
                        <input type="date">
                    </div>
                </div>
            </div>
        </section>

        <!-- Апелляция -->

        <section class="details-section">
            <h2 class="section-title">АПЕЛЛЯЦИЯ</h2>
            <div class="case-section">
                <div class="case-grid case-grid-2">
                    <div class="field-label">
                        <span>Иск подан (дата)</span>
                    </div>

                    <div class="field-value">
                        <input type="date">
                    </div>

                    <div class="field-label">
                        <span>Решение получено (дата)</span>
                    </div>

                    <div class="field-value">
                        <input type="date">
                    </div>
                </div>
            </div>
        </section>

        <!-- Исполнительное производство -->

        <section class="details-section">
            <div class="store-details">
                <h2 class="section-title">ИСПОЛНИТЕЛЬНОЕ ПРОИЗВОДСТВО</h2>
                <div class="case-grid case-grid-2">

                    <div class="field-label">
                        <span>Исполнительное производство (дата)</span>
                    </div>

                    <div class="field-value">
                        <input type="date">
                    </div>

                </div>
            </div>
        </section>

        <section class="details-section">
            <div class="store-details">
                <h2 class="section-title">ЗАВЕРШЕНИЕ ДЕЛА</h2>
                <div class="case-grid case-grid-4">

                    <div class="field-label">
                        <span>Завершено (статус)</span>
                    </div>

                    <div class="field-value">
                        <select name="case-status">
                            <option value="settlement">
                                Мировое соглашение
                            </option>

                            <option value="court">
                                Решение суда
                            </option>

                            <option value="withdrawn">
                                Иск отозван
                            </option>
                        </select>
                    </div>


                    <div class="field-label">
                        <span>Завершено (дата)</span>
                    </div>

                    <div class="field-value">
                        <input type="date">
                    </div>

                </div>

            </div>
        </section>

        <section class="details-secction">
            <div class="details-btn-container">
                <button type="button">Удалить кейс</button>
                <button type="button">Перезапустить кейс</button>
                <button type="button">Сохранить</button>
            </div>
        </section>

    </form>

    <section class="details-secction save-btn-out">
        <div class="save-btn-container">
            <button type="button">Сохранить</button>
        </div>
    </section>

    <!-- History block -->

    <div class="history-container invisible">
        <h2 class="page-title">История</h2>

        <div class="history-case pattern">
            <button class="accordion">
                <div class="history-created-btn">
                    <span>Создан:</span>
                    <span class="h-creation-date"></span>
                </div>
                <div>
                    <span>Завершен:</span>
                    <span class="h-case-complete-date"></span>
                </div>
            </button>
            <div class="panel">
                <div class="formbold-mb-5">

                    <div class="w-full detales-point history-point-margin">
                        <label for="date"> Дата создания: </label>
                        <label class="h-creation-date"></label>
                    </div>

                    <div class="w-full detales-point history-point-margin">
                        <label for="date"> Последний статус: </label>
                        <label id="h-last-status"></label>
                    </div>

                    <div class="w-full detales-point history-point-margin">
                        <label for="date"> Последнее действие: </label>
                        <label id="h-last-action"></label>
                    </div>

                    <div class="w-full detales-point history-point-margin">
                        <label for="date"> Дата последнего действие: </label>
                        <label id="h-last-action-date"></label>
                    </div>

                    <div class="w-full detales-point history-point-margin">
                        <div class="flex formbold--mx-3">
                            <div class="w-full formbold-px-3">
                                <div class="datales-link-container">
                                    <label for="">Ссылка на магазин:</label>
                                    <input id="h-link-store" type="text" class="formbold-form-input" />
                                    <button id="open-link-store" type="button"><img src="../images/show-link-icon.svg"
                                            alt=""></button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="w-full detales-point history-point-margin">
                        <label for="date"> Продукты: </label>
                        <label id="h-products"></label>
                    </div>

                    <div class="w-full detales-point history-point-margin">
                        <label for="date"> Завершен со статусом: </label>
                        <label id="h-complete-status"></label>
                    </div>

                    <div class="w-full detales-point history-point-margin">
                        <label for="date"> Дата завершения: </label>
                        <label class="h-case-complete-date"></label>
                    </div>

                </div>
            </div>
        </div>

    </div>