<div class="container container-border">
    <div class="formbold-form-wrapper">

        <h1 class="section-title">Поиск</h1>
        <p>По ИМЕНИ или ОГРН / ОГРНИП</p>
        <div class="flex flex-wrap formbold--mx-3">
            <div class="w-full">
                <div class="formbold-mb-5 w-full">
                    <div class="formbold-mb-5 input-search">
                        <input id="search-input" type="text" class="formbold-form-input" />
                        <div id="search-results" class="search-results"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="result-serch-tbl invisible">
        <table class="responsive-table">
            <thead>
                <p class="search-result-title">Результат поиска:</p>
                <tr>
                    <th class="td-w4" scope="col">№</th>
                    <th class="td-w12" scope="col">создан</th>
                    <th class="td-w12" scope="col">инн</th>
                    <th class="td-w12" scope="col">огрн</th>
                    <th class="td-w22" scope="col">имя</th>
                    <th class="td-w4" scope="col">платформа</th>
                    <th class="td-w12" scope="col">статус</th>
                    <th class="td-w12" scope="col">изменен</th>
                    <th class="" scope="col">исп.</th>
                </tr>
            </thead>
            <tbody id="search-table">

            </tbody>
        </table>
    </div>
</div>


<!-- Цели -->
<div class="container target-container">
    <table class="responsive-table">
        <h1 class="section-title">Цели</h1>
        <div class="comment-mark">
            <ul>
                <li>
                    <div class="comment-mark-item">
                        <p>Цель маркированная "</p><img src="../icons/label-important.png" alt="">
                        <p>" намечена для закупки.</p>
                    </div>
                </li>
                <li>
                    <div class="comment-mark-item">
                        <p>Цель маркированная "</p><img src="../icons/purchase-check.png" alt="">
                        <p>" ожидание доставки заказа.</p>
                    </div>
                </li>
                <li>
                    <p>Для немаркированных целей смотри комментарий.</p>
                </li>
            </ul>
        </div>
        <thead>
            <tr>
                <th class="td-w4" scope="col">№</th>
                <th class="td-w12" scope="col">создан</th>
                <th class="td-w12" scope="col">инн</th>
                <th class="td-w12" scope="col">огрн</th>
                <th class="td-w22" scope="col">имя</th>
                <th class="td-w4" scope="col">платформа</th>
                <th class="td-w12" scope="col">статус</th>
                <th class="td-w12" scope="col">изменен</th>
                <th scope="col">исп</th>
                <th scope="col">марк.</th>
                <th scope="col">ожид.</th>
            </tr>
        </thead>
        <tbody id="targets-table">

        </tbody>
    </table>
</div>

